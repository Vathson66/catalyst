            "id": "n_why",
            "type": "featureGrid",
            "settings": {
              "heading": "Why specifiers choose it",
              "columns": {
                "desktop": 3,
                "tablet": 2,
                "mobile": 1
              },
              "gap": {
                "token": "space.lg"
              },
              "items": [
                {
                  "title": "Breathable",
                  "body": "Water vapour escapes while liquid water is repelled, so the substrate dries rather than trapping moisture behind a film."
                },
                {
                  "title": "Invisible finish",
                  "body": "Penetrates rather than coating. No gloss, no colour shift, no plastic sheen on natural stone."
                },
                {
                  "title": "Ten-year performance",
                  "body": "Independently tested for freeze-thaw and salt resistance across the full masonry range."
                },
                {
                  "title": "Single flood coat",
                  "body": "One application, wet-on-wet. No primer, no second visit, no scaffolding hire twice."
                },
                {
                  "title": "Low VOC",
                  "body": "Water-based chemistry that meets current site and environmental requirements without a variance."
                },
                {
                  "title": "Documented",
                  "body": "Safety data sheets, technical bulletins and coverage tables published for every product."
                }
              ]
            }
          }
        ]
